# Vendored bytes are authenticated by provenance manifests. Preserve them on
# every checkout, including Windows with core.autocrlf enabled.
src/pix/viewer/assets/vendor/* -text

# Native current-cut fixture bytes are hashed and compared across platforms.
/tests/fixtures/current_cut/**/*.json text eol=lf

# Collaboration native artifacts use exact UTF-8 bytes across platforms.
/tests/fixtures/collaboration_handover/*.json -text
/docs/reports/evidence/collaboration-handover-20261107/**/*.json -text
/docs/reports/evidence/participant-lineage-fix-20261107/**/*.json -text
# Preserve the independent reviewer's original CRLF evidence without treating CR as trailing space.
/docs/reports/evidence/participant-lineage-fix-20261107/original-review-probe.json whitespace=cr-at-eol
# Pytest's captured failure output contains an intentional blank assertion gutter.
/docs/reports/evidence/participant-lineage-fix-20261107/test-attribute-position-failure.txt whitespace=-blank-at-eol
/docs/reports/evidence/participant-lineage-fix-20261107/independent-review/* -text whitespace=cr-at-eol
/docs/reports/evidence/live-pida-smoke-20261107/**/*.json -text whitespace=cr-at-eol
/docs/reports/evidence/live-pida-smoke-20261107/source/historical-live-harness.mjs -text whitespace=cr-at-eol
